# Auth (Better Auth, docs/architecture/auth-better-auth.md)
# Signs sessions and one-time links. Required in production: openssl rand -base64 32
BETTER_AUTH_SECRET=your_random_secret
# Optional: overrides NEXT_PUBLIC_APP_URL as the origin used for OAuth callbacks and e-mail links.
# BETTER_AUTH_URL=https://www.pawelperfect.com
# Extra origins (comma separated) allowed to call /api/auth, e.g. a test host. www and apex of the app URL are automatic.
# BETTER_AUTH_TRUSTED_ORIGINS=https://apptest.pawelperfect.com
# Key for the keyed hashes (HMAC) of client IP addresses and user agents stored with playback sessions
# and views (lib/modules/privacy). Recommended in production (>= 32 chars, openssl rand -base64 32).
# When unset it is derived from BETTER_AUTH_SECRET; changing either changes all new hashes.
# IP_HASH_SECRET=
# Google sign-in + One Tap. Redirect URI: <app url>/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Cloudflare Turnstile (bot check on sign-up, sign-in, password reset). Site key is public, read at runtime.
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Vercel Blob
BLOB_READ_WRITE_TOKEN=your_blob_token

# Database (Neon)
DATABASE_URL="postgresql://user:pass@ep-host.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-host.aws.neon.tech/neondb?sslmode=require"
PGHOST=ep-host.aws.neon.tech
PGUSER=user
PGDATABASE=neondb
PGPASSWORD=pass

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Email: Amazon SES over SMTP (eu-north-1) is the only transport. docs/operations/EMAIL_SES.md
EMAIL_FROM="Pawel Perfect <no-reply@pawelperfect.com>"
EMAIL_REPLY_TO=support@pawelperfect.com
EMAIL_SUPPORT_FROM=support@pawelperfect.com
# SES SMTP credentials from the SES console (NOT IAM access keys); required in production
SES_SMTP_USER=replace-with-ses-smtp-username
SES_SMTP_PASS=replace-with-ses-smtp-password
# AWS_REGION=eu-north-1
# SES_SMTP_HOST=email-smtp.eu-north-1.amazonaws.com
# Bounce/complaint events (SNS -> /api/webhooks/ses). SES_SNS_TOPIC_ARN is the topic allowlist: unset = endpoint refuses all.
# SES_CONFIGURATION_SET=pawelperfect-default
# SES_SNS_TOPIC_ARN=arn:aws:sns:eu-north-1:123456789012:ses-events
# SES_SNS_REGIONS=eu-north-1
# Caps shown in the admin panel (defaults: SES sandbox 200 per day / 6000 per month)
# EMAIL_DAILY_LIMIT=
# EMAIL_MONTHLY_LIMIT=

# App Config
APP_ENV=development
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional bootstrap/recovery email for seed/repair scripts only; not runtime admin access.
ADMIN_EMAIL=your-admin-email@example.com
# There is no admin bootstrap by e-mail any more (ADMIN_EMAILS was removed in phase 5 of the admin plan).
# The ADMIN role of a public account is the User.role column; the panel has its own accounts (admin.env).
DISPLAY_EUR_TO_PLN_RATE=4.3
DISPLAY_USD_TO_PLN_RATE=4.0

# Patronage
REFERRAL_PATRON_THRESHOLD=5

# Out-of-band tip channels shown in the patron-only tip jar ("Bramka Napiwkowa").
# Display-only: nothing here is recorded, verified or reconciled by the app, and none of it
# grants access — the viewer is already a patron. The BLIK number is a code constant.
# Until a wallet address is set, that coin's step renders a "do not send funds here" warning
# and refuses to expose a copyable address, because crypto sent to a wrong address is
# unrecoverable. Set these to wallets you actually control to make crypto tipping live.
NEXT_PUBLIC_TIP_BTC_ADDRESS=
NEXT_PUBLIC_TIP_ETH_ADDRESS=

# App mode
# [REMOVED] Polutek is now strict single-channel. Multi-creator mode is removed from runtime.

# Configured main channel slug. Required.
MAIN_CREATOR_SLUG=your-creator-slug
# Optional display name used by local content repair scripts when creating the configured creator.
MAIN_CREATOR_NAME=your-creator-display-name

# Demo content fallback. Enable only for local/dev/test first-run demos.
# Production code ignores this flag even if it is set to true; real production content must come from the database.
ENABLE_DEMO_FALLBACKS=false

# Security
HEALTHCHECK_TOKEN=your_secure_token
EMAIL_UNSUBSCRIBE_SIGNING_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-32-random-characters

# Rate Limiting (Upstash Redis / Vercel KV)
# Required in production. Memory fallback is allowed only in development/test.
# Preferred explicit Upstash names:
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
# Vercel KV fallback names are also supported for the writable REST credentials.
# Do not use KV_REST_API_READ_ONLY_TOKEN for rate limiting; counters must be writable.
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...

# Media Bucket / CDN host allowlist for /api/media and admin video URLs.
# Use exact controlled hosts only (for example a specific bucket host or CDN CNAME).
# Do not put broad provider domains such as r2.dev, r2.cloudflarestorage.com, or vercel-storage.com. HTTPS is required.
MEDIA_BUCKET_HOST=your-bucket.r2.dev
# Public host of the R2 thumbnail bucket (custom domain or its exact pub-<hash>.r2.dev host).
# Published video thumbnails are served straight from here; see CLAUDE.md §4.8.
NEXT_PUBLIC_R2_PUBLIC_HOST=cdn.yourdomain.com
NEXT_PUBLIC_BLOB_PUBLIC_HOST=your-project.public.blob.vercel-storage.com
ALLOWED_MEDIA_HOSTS=cdn.yourdomain.com,your-bucket.r2.dev

# Cloudflare R2 (S3 API). The account/credentials are shared by the video-originals
# bucket and the two thumbnail buckets; the API token needs Object Read & Write on all of them.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_VIDEO_ORIGINALS=
# Every admin thumbnail upload (drafts included) lands here. Must NOT have public access.
CLOUDFLARE_R2_BUCKET_THUMBNAILS_PRIVATE=polutek-thumbnails-private
# Holds copies of PUBLISHED videos' thumbnails only; exposed at NEXT_PUBLIC_R2_PUBLIC_HOST.
CLOUDFLARE_R2_BUCKET_THUMBNAILS_PUBLIC=polutek-thumbnails

# Dedicated image allowlists. Keep these separate unless comments/avatars really share the same controlled storage.
ALLOWED_THUMBNAIL_HOSTS=img.clerk.com,thumbs.yourdomain.com
ALLOWED_COMMENT_IMAGE_HOSTS=comments.yourdomain.com
ALLOWED_AVATAR_HOSTS=avatars.yourdomain.com

# Own HLS delivery: the ONLY video source (docs/operations/HLS-SELF-HOSTED.md). At least 32 chars; same value as the Worker secret.
HLS_TOKEN_SECRET=
HLS_DELIVERY_BASE_URL=https://video.pawelperfect.com

# ---------------------------------------------------------------------------------------------
# Admin panel (apps/admin, admin.pawelperfect.com). Lives in admin.env on the server, NOT in app.env.
# Runbook: docs/operations/ADMIN-PANEL.md. The panel ignores BETTER_AUTH_SECRET.
# Same database as the site (DATABASE_URL, host "db" inside Docker Compose).
ADMIN_APP_URL=https://admin.pawelperfect.com
# Own secret of the panel's Better Auth instance (min. 32 chars, different from BETTER_AUTH_SECRET): openssl rand -base64 48
ADMIN_AUTH_SECRET=
# Cloudflare Access (layer 1): team domain and the AUD tag of the "serwerek admin" Access application.
# Without both, production answers 503 to everything (fail closed).
CF_ACCESS_TEAM_DOMAIN=https://pawelperfect.cloudflareaccess.com
CF_ACCESS_AUD=
# Sign-in mode: "access" (default, Cloudflare Access e-mail code is the login, no enrollment) or "passkey"
# (legacy: Access + passkey + TOTP, needs admin-enroll). Any other value makes the panel answer 503.
# ADMIN_AUTH_MODE=access
# Identities (comma separated) the panel accepts. Access mode: empty = only ADMIN_OWNER_EMAIL (pawel.perfect@gmail.com).
ADMIN_ACCESS_EMAILS=pawel.perfect@gmail.com
# The one address created automatically (role OWNER) at first sign-in in access mode.
# ADMIN_OWNER_EMAIL=pawel.perfect@gmail.com
# Probes on the System screen (each optional; an unset one shows "not measured", never an error).
# KV_REST_API_URL / KV_REST_API_TOKEN (Redis REST, same values as the site) and HLS_DELIVERY_BASE_URL are read too.
ADMIN_INTERNAL_APP_URL=http://app:3000
# Host status file written by deploy/serwerek/admin/host-status.py (directory mounted read-only).
ADMIN_HOST_STATUS_FILE=/host-status/status.json
# "Zapas serwera" meter: read-only telemetry connection as role pp_analytics_ro (LOGIN enabled by the operator,
# SERWEREK.md §22). Unset = the meter says "not configured". Capacity numbers: lib/modules/admin-overview/domain/server-capacity.config.ts.
ADMIN_TELEMETRY_DATABASE_URL=
# Analytics (phase A). Own page views vs Cloudflare document requests: tolerated deviation in percent (default 30).
# ADMIN_EDGE_TOLERANCE_PCT=30
# Morning report e-mail: BUILT BUT OFF. Sent only when ADMIN_MORNING_REPORT=on AND ADMIN_MORNING_REPORT_TO is a valid address.
# ADMIN_JOBS_TOKEN (>= 32 characters) lets a scheduler POST /api/jobs/morning-report with "Authorization: Bearer ...".
# ADMIN_MORNING_REPORT=off
# ADMIN_MORNING_REPORT_TO=
# ADMIN_JOBS_TOKEN=
# Local development only (ignored when NODE_ENV=production):
#   ADMIN_DEV_BYPASS_ACCESS=1  skip Cloudflare Access on localhost
#   (access mode: acts as ADMIN_DEV_EMAIL, default the owner; needs the database)
#   ADMIN_DEV_BYPASS_AUTH=1    render the shell without signing in
#   ADMIN_DEV_FIXTURES=1       sample data instead of the database (labelled "Dane przykładowe")

# Admin panel phase 3 (admin.env only; docs/architecture/admin-phase3.md section 7)
#   STRIPE_SECRET_KEY=            restricted key (refunds write; disputes, charges, payment intents read)
#   SES_SMTP_USER=, SES_SMTP_PASS=, EMAIL_FROM=  only for "send a test to myself" in the broadcast wizard
#   EMAIL_DAILY_LIMIT=200  EMAIL_MONTHLY_LIMIT=6000   caps shown on Komunikacja
#   TRANSLATION_AI_ENABLED=1  CLOUDFLARE_AI_ACCOUNT_ID=  CLOUDFLARE_AI_API_TOKEN=   draft translations (Workers AI free tier), OFF by default
