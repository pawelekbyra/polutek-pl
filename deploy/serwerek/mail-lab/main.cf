# Send-only Postfix for the mail lab and the app's own mail path (docs/operations/MAIL-OWN-TRANSPORT.md).
# Mail is handed over locally (docker exec ... sendmail) or by the app over SMTP on the private docker network
# pp-mail-submit (no published port, only that network may submit). Outbound goes out of the host IP over IPv4.
compatibility_level = 3.9

# Identity: HELO name equals the PTR of the server IP (mail.pawelperfect.com), forward and reverse match.
myhostname = mail.pawelperfect.com
myorigin = lab.pawelperfect.com
mydomain = lab.pawelperfect.com
mydestination =
alias_maps =
alias_database =
local_transport = error:local delivery is disabled
relayhost =
# Who may submit: loopback plus the private submission network (entrypoint.sh sets mynetworks from SUBMIT_NETWORK).
mynetworks = 127.0.0.0/8

# Listens on the container's own interfaces only (loopback and pp-mail-submit; nothing is published to the host).
# Not a mail server: it relays only for mynetworks and accepts nothing for local delivery.
inet_interfaces = all
inet_protocols = ipv4
smtpd_client_restrictions = permit_mynetworks, reject
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination
smtpd_recipient_restrictions = permit_mynetworks, reject
smtpd_helo_required = no
message_size_limit = 5242880
smtpd_tls_security_level = none
smtpd_banner = $myhostname ESMTP

# Outbound TLS whenever the other side offers it.
smtp_tls_security_level = may
smtp_tls_loglevel = 1
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt

# DKIM signing through OpenDKIM (milter on loopback).
milter_default_action = accept
smtpd_milters = inet:127.0.0.1:8891
non_smtpd_milters = inet:127.0.0.1:8891

# Slow and polite on purpose: one connection at a time, a pause between messages to the same provider.
default_destination_concurrency_limit = 1
default_destination_rate_delay = 5s
smtp_connect_timeout = 20s
maximal_queue_lifetime = 1d
bounce_queue_lifetime = 1d

# Logs go to stdout (docker logs).
maillog_file = /dev/stdout

# Bounces and errors for this experiment stay local (the lab domain has no MX).
notify_classes =
