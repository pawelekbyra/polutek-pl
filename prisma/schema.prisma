/// A film in one more language (docs/architecture/translations-concept.md, admin-phase2-content.md section 6).
/// The original language is the Video row itself (PL). During the transition Video.titleEn/descriptionEn and
/// Video.subtitleUrlPl/En stay the source the site and the player read; the panel keeps them in sync for "en".
/// Public addresses per language are NOT live yet (owner hold): `slug` is reserved and unique per language.
model VideoTranslation {
  id           String                 @id @default(uuid())
  videoId      String
  /// Lower-case BCP 47 primary tag: "en", "de", "es", "fr", "it", "pt", "zh" (never "pl", the original).
  language     String
  title        String
  slug         String
  description  String?
  subtitleUrl  String?
  status       VideoTranslationStatus @default(AI_DRAFT)
