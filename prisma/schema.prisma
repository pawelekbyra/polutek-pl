  subscribers Int

  channel Creator @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([channelId, day])
}

/// Where a signed-in viewer stopped in a video ("continue watching").
model VideoProgress {
  userId          String
  videoId         String
  positionSeconds Int
  durationSeconds Int?
  updatedAt       DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@id([userId, videoId])
  @@index([userId, updatedAt])
}

enum AppealStatus {
  PENDING
  UPHELD
  REJECTED
}

/// A creator's appeal against a moderation decision (DSA art. 20). Reviewed by a human; the decision itself stays
/// immutable, the outcome is a new ModerationDecision referenced from `outcomeDecisionId`.
model ModerationAppeal {
  id                String       @id @default(uuid())
  decisionId        String
  userId            String
  channelId         String?
  text              String       @db.Text
  status            AppealStatus @default(PENDING)
  createdAt         DateTime     @default(now())
  resolvedAt        DateTime?
  resolvedByAdminId String?
  outcomeDecisionId String?

  decision ModerationDecision @relation(fields: [decisionId], references: [id])
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([decisionId])
  @@index([userId])
}
