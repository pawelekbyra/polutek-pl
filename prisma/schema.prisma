generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  // Better Auth user id (rows from before 2026-10-02 keep the id the old identity provider gave them).
  id                            String     @id
  email                         String     @unique
  username                      String?
  name                          String?
  isDeleted                     Boolean    @default(false)
  role                          SystemRole @default(USER)
  language                      String     @default("en")
  stripeCustomerId              String?    @unique
  imageUrl                      String?
  // Better Auth core field. Rows that predate Better Auth were verified by the old identity
  // provider, so the migration marks them verified.
  emailVerified                 Boolean    @default(false)
  // Better Auth twoFactor plugin flag (TOTP).
  twoFactorEnabled              Boolean?   @default(false)
  // True for every new account (e-mail or Google), and for older accounts whose name breaks the
  // nickname rules, until the user picks a nickname in the first-sign-in dialog. While true, `name`
  // is only a placeholder: it does not reserve the nickname and the account cannot comment or react.
  // Nicknames of active, onboarded accounts are unique case-insensitively through the partial index
  // "User_name_lower_active_key" (migration 20261003200000, not expressible in this schema).
  onboardingPending             Boolean    @default(false)
  // Latest version of the Terms (the documents' effective date, LEGAL_DOCUMENTS_VERSION) this user
  // accepted, and when: stamped at sign-up and again when a tip is sent with the Terms ticked.
  // Null for accounts created before acceptance was recorded (2026-10-04).
  termsAcceptedAt               DateTime?
  termsVersion                  String?
  // Moderation mute (admin panel, Społeczność): until this instant the account may read and react but
  // not write comments. Null = not muted; an expired value is the same as null. Set only by
  // muteUserCommenting (audited), cleared by unmuteUserCommenting.
  commentMutedUntil             DateTime?
  commentMuteReason             String?
  createdAt                     DateTime   @default(now())
  updatedAt                     DateTime   @updatedAt

  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  passkeys         Passkey[]
  avatar          UserAvatar?
  creators         Creator[]
  comments         Comment[]
  commentReactions CommentReaction[]
  commentReports   CommentReport[]
  videoLikes       VideoLike[]
  videoDislikes    VideoDislike[]
  payments         Payment[]
  paymentTotals    UserPaymentTotal[]
  patronGrants          PatronGrant[]
  subscriptions         Subscription[]
  notifications         Notification[]
  notificationPreference NotificationPreference?
  channelMemberships    ChannelMember[]
  channelBans           ChannelBan[]
  orders                Order[]
  entitlements          Entitlement[]
  videoProgress         VideoProgress[]
  moderationAppeals     ModerationAppeal[]

  @@index([email])
}

// Better Auth tables (docs/architecture/auth-better-auth.md). `User` above is the Better Auth
// user; these four hold sessions, linked login methods (credential password, Google), one-time
// tokens (email verification, password reset) and TOTP secrets.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// Avatar picked by the user (256 px JPEG/PNG/WebP, a few KB), served by /api/avatars/[userId];
// User.imageUrl points at that route. A separate table keeps the bytes out of every User read.
model UserAvatar {
  userId    String   @id
  mime      String
  data      Bytes
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TwoFactor {
  id          String @id
  secret      String
  backupCodes String
  userId      String
  verified    Boolean   @default(true)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime?
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Better Auth passkey plugin (WebAuthn). Only the public key and metadata are stored; the private
// key never leaves the user's device. `credentialID` is unique across all users (WebAuthn L3 §7.1).
model Passkey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String    @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
  REFUNDED
  PARTIALLY_REFUNDED
  DISPUTED
  CHARGEBACK_LOST
}

model Payment {
  id                  String        @id @default(uuid())
  userId              String
  creatorId           String?
  stripeIntentId      String?       @unique
  stripeSessionId     String?       @unique
  requestId           String?
  amountMinor         Int
  refundedAmountMinor Int           @default(0)
  refundedById        String?
  refundedAt          DateTime?
  refundReason        String?
  /// Last time the refund total was reconciled against Stripe's refund list (PA-04); NULL = never.
  refundsCheckedAt    DateTime?
  currency            String
  status              PaymentStatus @default(PENDING)
  metadata            Json?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  creator Creator? @relation(fields: [creatorId], references: [id])

  @@unique([userId, requestId])
  @@index([userId, status])
  @@index([userId])
  @@index([creatorId])
  @@index([status])
  @@index([status, createdAt])
  @@index([createdAt])
}

enum WebhookEventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model StripeEvent {
  id          String             @id
  type        String
  status      WebhookEventStatus @default(PROCESSING)
  payload     Json?
  error       String?
  processedAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

enum PatronGrantSource {
  STRIPE_TIP
  PAYMENT
  REFERRAL
  ADMIN
  MIGRATION
  LEGACY
}

model PatronGrant {
  id          String            @id @default(uuid())
  userId      String
  source      PatronGrantSource
  paymentId   String?           @unique
  grantedById String?
  reason      String?
  createdAt   DateTime          @default(now())
  revokedAt   DateTime?
  revokedById String?
  revokeReason String?

  user User @relation(fields: [userId], references: [id])

  @@index([userId, revokedAt])
  @@index([userId])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  targetType  String?
  targetId    String?
  metadata    Json?
  actorType   String?
  systemReason String?
  requestId   String?
  ip          String?
  userAgent   String?
  /// Channel the event concerns (null = platform-wide); lets the panel filter per channel.
  channelId   String?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([channelId, createdAt])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------------------------
// Admin panel identity (apps/admin, admin.pawelperfect.com). A SEPARATE Better Auth instance with its
// own tables: a public-site session, password reset or Google sign-in never leads into the panel.
// No sign-up and no e-mail reset: an account appears only through the server CLI `admin-enroll`
// (one-time link), sign-in is passkey only, TOTP is the step-up fallback. docs/architecture/admin-panel.md.
model AdminUser {
  id               String    @id
  email            String    @unique
  name             String
  emailVerified    Boolean   @default(true)
  image            String?
  twoFactorEnabled Boolean?  @default(false)
  /// Set when the enrollment finished (TOTP verified and at least one passkey). Null = the account may
  /// only reach the enrollment screen.
  enrolledAt       DateTime?
  /// OWNER = the whole panel (default, every account until phase 3). TRANSLATOR = only the translation
  /// screens, only the languages in AdminLanguageGrant. Checked by requireAdmin(); a plain string so a
  /// new role is an additive change (validated in code, apps/admin/lib/auth/roles.ts).
  role             String    @default("OWNER")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessions    AdminSession[]
  accounts    AdminAccount[]
  passkeys    AdminPasskey[]
  twoFactors  AdminTwoFactor[]
  enrollments AdminEnrollment[]
  languageGrants AdminLanguageGrant[]
}

/// Which translation languages a TRANSLATOR account may write (one row per language).
/// `level` is reserved for the later approval thresholds (TRANSLATOR < REVIEWER < LEAD); today only TRANSLATOR is used.
model AdminLanguageGrant {
  id          String    @id @default(uuid())
  adminUserId String
  language    String
  level       String    @default("TRANSLATOR")
  grantedAt   DateTime  @default(now())
  user        AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, language])
}

model AdminSession {
  id        String    @id
  expiresAt DateTime
  token     String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  ipAddress String?
  userAgent String?
  /// Last successful step-up (TOTP) on this session; a passkey step-up creates a new session instead.
  stepUpAt  DateTime?
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Required by Better Auth; the panel has no password or OAuth sign-in, so it normally stays empty.
model AdminAccount {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model AdminVerification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model AdminPasskey {
  id           String    @id
  name         String?
  publicKey    String
  userId       String
  user         AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String    @unique
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime? @default(now())
  aaguid       String?

  @@index([userId])
}

model AdminTwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?
  user                    AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One-time enrollment link printed by `admin-enroll` in the server terminal (never e-mailed).
/// Only the SHA-256 of the token is stored; it expires after 15 minutes and works once.
model AdminEnrollment {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  user        AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Append-only log of panel sign-ins, step-ups and enrollment events. A database trigger refuses
/// UPDATE and refuses DELETE of rows younger than 400 days; `hash` chains each row to the previous one
/// (sha256 of the previous hash and the row), so a rewritten history is detectable.
model AdminAuthEvent {
  id          String   @id @default(uuid())
  seq         BigInt   @unique @default(autoincrement())
  action      String
  adminUserId String?
  email       String?
  outcome     String
  reason      String?
  ip          String?
  country     String?
  userAgent   String?
  requestId   String?
  prevHash    String?
  hash        String
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Creator {
  id                      String         @id @default(uuid())
  userId                  String
  slug                    String         @unique
  name                    String
  bio                     String?
  defaultThumbnailUrl     String?
  subscribersCount        Int            @default(0)
  displaySubscribersCount Int?
  /// Public handle shown as @handle (3-30 chars a-z 0-9 . _ -). Unique case-insensitively through the partial index
  /// "Creator_handle_lower_key" (migration 20261013120000, not expressible in this schema). Null until chosen.
  handle                  String?
  /// Channel lifecycle (multi-creator platform, docs/architecture/multi-creator-platform.md). Transitions live in
  /// lib/modules/channel (one place), never as ad-hoc updates.
  status                  ChannelStatus  @default(ACTIVE)
  statusReason            String?
  statusChangedAt         DateTime?
  /// AdminUser.id of the staff member who changed the status (null = the system or the owner).
  statusChangedById       String?
  /// Storage value of the channel avatar (same rule as Video.thumbnailUrl: never a derived address).
  avatarUrl               String?
  country                 String?
  language                String?
  isVerified              Boolean        @default(false)
  /// Soft delete: the channel is hidden at once and purged for good after `deleteAfter`.
  deletedAt               DateTime?
  deleteAfter             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  user                    User           @relation(fields: [userId], references: [id])
  videos                  Video[]
  payments                Payment[]
  comments                Comment[]
  subscriptions           Subscription[]
  members                 ChannelMember[]
  handleHistory           ChannelHandleHistory[]
  quota                   ChannelQuota?
  strikes                 ChannelStrike[]
  bans                    ChannelBan[]
  orders                  Order[]
  ledger                  LedgerEntry[]
  subscriberSnapshots     SubscriberSnapshot[]
}

enum ChannelStatus {
  PENDING_REVIEW
  ACTIVE
  LIMITED
  SUSPENDED
  BANNED
  DELETED
}

enum ChannelRole {
  OWNER
  MANAGER
  EDITOR
  MODERATOR
  TRANSLATOR
}

/// A user's role in a channel. The channel owner always has an OWNER row (backfilled from Creator.userId);
/// authorization falls back to Creator.userId when a row is missing (lib/modules/authz).
model ChannelMember {
  id          String      @id @default(uuid())
  channelId   String
  userId      String
  role        ChannelRole
  invitedById String?
  acceptedAt  DateTime?
  createdAt   DateTime    @default(now())

  channel Creator @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
}

/// Handles a channel used to have. While `reservedUntil` is in the future nobody else can take the handle and
/// requests to it redirect (301) to the channel's current handle.
model ChannelHandleHistory {
  id            String   @id @default(uuid())
  channelId     String
  handle        String
  releasedAt    DateTime @default(now())
  reservedUntil DateTime

  channel Creator @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([handle, reservedUntil])
  @@index([channelId])
}

/// Per-channel limits (uploads, storage, queue). Absent row = the platform defaults in lib/platform-limits.ts.
model ChannelQuota {
  channelId        String   @id
  trustLevel       Int      @default(0)
  maxStorageBytes  BigInt
  maxUploadBytes   BigInt
  maxVideoSeconds  Int
  maxUploadsPerDay Int
  maxQueuedJobs    Int
  usedStorageBytes BigInt   @default(0)
  updatedAt        DateTime @updatedAt

  channel Creator @relation(fields: [channelId], references: [id], onDelete: Cascade)
}

enum ReportTargetType {
  VIDEO
  CHANNEL
  COMMENT
}

enum ContentReportStatus {
  PENDING
  DISMISSED
  ACTION_TAKEN
}

/// A notice about a video, channel or comment (DSA art. 16, UoRiT art. 47s: decision within 48 h). Comment
/// reports keep using CommentReport; this table is for videos and channels.
model ContentReport {
  id                String              @id @default(uuid())
  targetType        ReportTargetType
  targetId          String
  channelId         String?
  reporterId        String?
  reporterEmail     String?
  reason            String
  note              String?
  status            ContentReportStatus @default(PENDING)
  createdAt         DateTime            @default(now())
  resolvedAt        DateTime?
  /// AdminUser.id of the staff member who resolved it.
  resolvedByAdminId String?
  decisionId        String?

  @@index([status, createdAt])
  @@index([channelId])
  @@index([targetType, targetId])
}

/// Statement of reasons (DSA art. 17): one immutable row per moderation decision. Append-only (trigger in the
/// migration): to change a decision write a new one.
model ModerationDecision {
  appeals        ModerationAppeal[]
  id             String           @id @default(uuid())
  targetType     ReportTargetType
  targetId       String
  channelId      String?
  action         String
  reasonCode     String
  reasonPublic   String
  reasonInternal String?
  legalBasis     String?
  automated      Boolean          @default(false)
  actorAdminId   String?
  reportId       String?
  createdAt      DateTime         @default(now())

  @@index([channelId, createdAt])
  @@index([targetType, targetId])
}

model ChannelStrike {
  id              String    @id @default(uuid())
  channelId       String
  videoId         String?
  reason          String
  policy          String
  issuedByAdminId String
  issuedAt        DateTime  @default(now())
  expiresAt       DateTime?
  appealedAt      DateTime?
  appealNote      String?
  revokedAt       DateTime?

  channel Creator @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, expiresAt])
}

/// A viewer a channel's owner has blocked from commenting on that channel.
model ChannelBan {
  channelId String
  userId    String
  until     DateTime?
  reason    String?
  createdAt DateTime @default(now())

  channel Creator @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

/// An address whose Resend Audience contact must still be removed (account deletion while Resend
/// was unreachable). Retried by /api/cron/retention; the row is deleted once Resend confirms.
model ResendContactRemoval {
  id            String   @id @default(uuid())
  email         String   @unique
  attempts      Int      @default(0)
  lastError     String?
  nextAttemptAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([nextAttemptAt])
}

/// A Stripe Customer whose personal data (e-mail, name, phone) must still be erased at Stripe after an
/// account deletion (PA-03). Written in the deletion transaction, so the deletion never depends on Stripe being
/// reachable; retried by the account-deletion path and daily by /api/cron/retention; the row is deleted once
/// Stripe confirms (the audit log keeps STRIPE_CUSTOMER_ANONYMIZED). No FK to User: the User row is a tombstone.
model StripeCustomerAnonymization {
  id               String   @id @default(uuid())
  stripeCustomerId String   @unique
  userId           String?
  attempts         Int      @default(0)
  lastError        String?
  nextAttemptAt    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([nextAttemptAt])
}

model Subscription {
  /// LEGACY: historical channel-follow/subscription records only.
  /// Do not use this model for premium/patron content access; active PatronGrant rows are the only access source of truth.
  id        String   @id @default(uuid())
  userId    String
  creatorId String
  /// The bell: false = subscribed but no notifications for this channel.
  notify    Boolean  @default(true)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId])
  @@index([userId])
  @@index([creatorId])
}

enum NotificationKind {
  WELCOME
  SYSTEM
  COMMENT
  SUPPORT
  PATRON
  NEW_VIDEO
  MODERATION
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  kind      NotificationKind
  titlePl   String
  titleEn   String
  bodyPl    String           @db.Text
  bodyEn    String           @db.Text
  href      String?
  /// Channel and video the notification is about (NEW_VIDEO, MODERATION); null for account-level kinds.
  channelId String?
  videoId   String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, read])
}

/// Per-user opt-out toggles for non-essential notification categories.
/// WELCOME is a one-time onboarding message and is never gated by preferences.
model NotificationPreference {
  id               String   @id @default(uuid())
  userId           String   @unique
  patronEnabled    Boolean  @default(true)
  commentEnabled   Boolean  @default(true)
  systemEnabled    Boolean  @default(true)
  /// New video of a subscribed channel: in-app (bell) and e-mail.
  newVideoInApp    Boolean  @default(true)
  newVideoEmail    Boolean  @default(true)
  /// Decisions about the user's own channel and videos.
  moderationEnabled Boolean @default(true)
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Admin-editable overrides for the standard notification copy. When a row exists
/// for a given `kind`, it replaces the hardcoded default in notificationTemplates;
/// otherwise the hardcoded default is used. Mirrors EmailTemplate's override pattern.
model NotificationTemplate {
  kind      NotificationKind @id
  titlePl   String
  titleEn   String
  bodyPl    String           @db.Text
  bodyEn    String           @db.Text
  updatedAt DateTime         @updatedAt
  updatedBy String?
}

model Video {
  id                                String      @id @default(uuid())
  creatorId                         String
  title                             String
  titleEn                           String?
  slug                              String      @unique
  description                       String?
  descriptionEn                     String?
  thumbnailUrl                      String
  // Public R2 copy of a PUBLISHED video's thumbnail (content-hashed key); null for drafts. See §4.8 of CLAUDE.md.
  thumbnailPublicUrl                String?
  subtitleUrlPl                     String?
  subtitleUrlEn                     String?
  duration                          String? // e.g. "12:45"
  tier                              AccessTier  @default(PUBLIC)
  views                             Int         @default(0)
  likesCount                        Int         @default(0)
  dislikesCount                     Int         @default(0)
  isMainFeatured                    Boolean     @default(false) // This video is the "One Hero Video" on homepage
  showInSidebar                     Boolean     @default(true)
  sidebarOrder                      Int         @default(0)
  status                            VideoStatus @default(DRAFT)
  publishedAt                       DateTime?
  // Scheduled premiere: while status = PUBLISHED and premiereAt > now the video is "upcoming"
  // (listed under "Coming soon", never playable). Null or past = ordinary video. See CLAUDE.md "Premieres".
  premiereAt                        DateTime?
  // Set once the viewers were told about this video (publish-time fan-out, or the premiere cron when premiereAt
  // passed). Claimed atomically (update where null), so a video is announced at most once. See CLAUDE.md 4.18.
  premiereNotifiedAt                DateTime?
  // Fundraising goal shown as an amount-free progress bar under the title (CLAUDE.md
  // "Fundraising progress bar"). Null goal = no bar. Never exposed in public DTOs.
  fundraisingGoalMinor              Int?
  fundraisingGoalCurrency           String?
  // Tips counted from this moment; null = all tips ever.
  fundraisingStartAt                DateTime?
  // Provisional bar fill set by hand, 0-100 (owner decision 2026-09-30). When set it
  // wins over the goal computation above; null = off.
  fundraisingManualPercent          Int?
  publishAfterAssetReady           Boolean     @default(false)
  publishAfterAssetReadyRequestedAt DateTime?
  publishAfterAssetReadyCompletedAt DateTime?
  publishAfterAssetReadyError       String?
  /// Free-form creator tags (max 15 of 30 characters, validated in the application; the database caps the count).
  tags                              String[]    @default([])
  /// One of the whitelist in lib/modules/video/domain/video-metadata.ts; null = not set.
  category                          String?
  /// Who may comment on the video: ON = published at once, HELD = every new comment waits for review, OFF = no new comments.
  commentsMode                      VideoCommentsMode @default(ON)
  /// Platform moderation state, separate from publication status: a REMOVED video is never public whatever `status` says.
  moderationStatus                  VideoModerationStatus @default(VISIBLE)
  /// Declared by the creator: adult content, signed-in viewers only (same effect as moderationStatus AGE_RESTRICTED).
