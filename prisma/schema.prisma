/// Since 2026-10-02 the only live video source is SELF_HLS (our own HLS: encoded by the worker, stored in the
/// private R2 bucket polutek-hls, delivered by the token-checked Worker at video.<domain>).
/// Every other value is LEGACY: kept only so the migration history and old rows stay valid. Application code
/// never writes them and never plays them (old rows are ignored; deleting them is a separate cleanup PR).
/// Do not drop values or add new providers without an explicit owner decision.
enum StorageProvider {
  /// LEGACY, unused: object storage asset.
  R2
  /// LEGACY, unused: object storage asset.
  S3
  /// LEGACY, unused: object storage asset.
  VERCEL_BLOB
  /// LEGACY, unused: former Cloudflare Stream provider (removed 2026-10-02).
  CLOUDFLARE_STREAM
  /// LEGACY, unused: former Mux provider (removed 2026-10-02).
  MUX
  /// Our own HLS. objectKey = "videos/<videoId>/v/<version>", bucket = R2 bucket polutek-hls.
  SELF_HLS
  /// LEGACY, unused: former YouTube embed source (removed 2026-10-02).
  YOUTUBE
  /// LEGACY, unused: former Vimeo embed source (removed 2026-10-02).
  VIMEO
}

